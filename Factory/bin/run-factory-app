#!/bin/zsh
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

APP_ROOT="/Users/chiburashka/Documents/Codex/Simastry/Factory"
PORT="${SIMASTRY_FACTORY_PORT:-8765}"
URL="http://127.0.0.1:${PORT}/"
LOG_DIR="${APP_ROOT}/workspace/logs"
PID_FILE="${LOG_DIR}/server.pid"
LOG_FILE="${LOG_DIR}/factory-server.log"

mkdir -p "${LOG_DIR}"

server_is_ready() {
  curl -fsS "${URL}api/stats" >/dev/null 2>&1
}

if server_is_ready; then
  open "${URL}"
  exit 0
fi

(
  for _ in {1..60}; do
    if server_is_ready; then
      open "${URL}"
      exit 0
    fi
    sleep 0.2
  done
  open "${URL}"
) >/dev/null 2>&1 &

cd "${APP_ROOT}"
echo "$$" > "${PID_FILE}"
exec python3 "${APP_ROOT}/server.py" --port "${PORT}" >> "${LOG_FILE}" 2>&1

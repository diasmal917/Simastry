{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Simastry",
  "options": {
    "deploymentTarget": {
      "iOS": "18.0"
    },
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "packages": {
    "Supabase": {
      "url": "https://github.com/supabase/supabase-swift.git",
      "from": "2.0.0"
    },
    "RevenueCat": {
      "url": "https://github.com/RevenueCat/purchases-ios-spm.git",
      "from": "5.0.0"
    },
    "SwissEphemeris": {
      "url": "https://github.com/vsmithers1087/SwissEphemeris.git",
      "from": "0.0.99"
    }
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Simastry": {
      "dependencies": [
        {
          "package": "Supabase",
          "product": "Supabase"
        },
        {
          "package": "RevenueCat",
          "product": "RevenueCat"
        },
        {
          "package": "SwissEphemeris",
          "product": "SwissEphemeris"
        }
      ],
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Simastry",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "CFBundleURLTypes": [
            {
              "CFBundleTypeRole": "Editor",
              "CFBundleURLName": "$(PRODUCT_BUNDLE_IDENTIFIER)",
              "CFBundleURLSchemes": [
                "simastry",
                "$(PRODUCT_BUNDLE_IDENTIFIER)"
              ]
            }
          ],
          "ITSAppUsesNonExemptEncryption": false,
          "NSCameraUsageDescription": "Take an optional Aura Snapshot photo to tune today’s color palette and guidance locally.",
          "NSMotionUsageDescription": "Create a subtle parallax effect that responds to how you move your device.",
          "NSPhotoLibraryAddUsageDescription": "Save shareable astrology cards to your photo library.",
          "UIApplicationSupportsIndirectInputEvents": true,
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait"
          ]
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "A6PP462J72",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.97a916bd-b131-48aa-a70e-082a3526b819",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application"
    },
    "SimastryUITests": {
      "dependencies": [
        {
          "target": "Simastry"
        }
      ],
      "platform": "iOS",
      "settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.97a916bd-b131-48aa-a70e-082a3526b819.uitests",
        "SWIFT_VERSION": "5.0",
        "TEST_TARGET_NAME": "Simastry"
      },
      "sources": [
        {
          "path": "UITests"
        }
      ],
      "type": "bundle.ui-testing"
    }
  }
}

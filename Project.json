{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Simastry",
  "options": {
    "deploymentTarget": {
      "iOS": "18.0"
    },
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "packages": {
    "Supabase": {
      "url": "https://github.com/supabase/supabase-swift.git",
      "exactVersion": "2.47.0"
    },
    "RevenueCat": {
      "url": "https://github.com/RevenueCat/purchases-ios-spm.git",
      "exactVersion": "5.78.0"
    },
    "SwissEphemeris": {
      "url": "https://github.com/vsmithers1087/SwissEphemeris.git",
      "exactVersion": "0.0.99"
    }
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Simastry": {
      "dependencies": [
        {
          "package": "Supabase",
          "product": "Supabase"
        },
        {
          "package": "RevenueCat",
          "product": "RevenueCat"
        },
        {
          "package": "SwissEphemeris",
          "product": "SwissEphemeris"
        },
        {
          "target": "SimastryWidgets",
          "embed": true
        }
      ],
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Simastry",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "2",
          "CFBundleURLTypes": [
            {
              "CFBundleTypeRole": "Editor",
              "CFBundleURLName": "$(PRODUCT_BUNDLE_IDENTIFIER)",
              "CFBundleURLSchemes": [
                "simastry",
                "$(PRODUCT_BUNDLE_IDENTIFIER)"
              ]
            }
          ],
          "ITSAppUsesNonExemptEncryption": false,
          "NSCameraUsageDescription": "Take an optional Aura Snapshot photo to tune today\u2019s color palette and guidance locally.",
          "NSContactsUsageDescription": "Import a person\u2019s name, photo, and birthday from Contacts when you choose to add them to your private People list.",
          "NSMotionUsageDescription": "Create a subtle parallax effect that responds to how you move your device.",
          "NSPhotoLibraryAddUsageDescription": "Save shareable astrology cards to your photo library.",
          "UIApplicationSupportsIndirectInputEvents": true,
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait"
          ]
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "2",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "A6PP462J72",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.97a916bd-b131-48aa-a70e-082a3526b819",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1"
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application",
      "entitlements": {
        "path": "App/Simastry.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.com.simastry.shared"
          ]
        }
      }
    },
    "SimastryTests": {
      "dependencies": [
        {
          "target": "Simastry"
        }
      ],
      "platform": "iOS",
      "settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.97a916bd-b131-48aa-a70e-082a3526b819.tests",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        {
          "path": "Tests"
        }
      ],
      "type": "bundle.unit-test"
    },
    "SimastryUITests": {
      "dependencies": [
        {
          "target": "Simastry"
        }
      ],
      "platform": "iOS",
      "settings": {
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.97a916bd-b131-48aa-a70e-082a3526b819.uitests",
        "SWIFT_VERSION": "5.0",
        "TEST_TARGET_NAME": "Simastry"
      },
      "sources": [
        {
          "path": "UITests"
        }
      ],
      "type": "bundle.ui-testing"
    },
    "SimastryWidgets": {
      "platform": "iOS",
      "type": "app-extension",
      "sources": [
        {
          "path": "Widget"
        },
        {
          "path": "App/Utilities/SharedDefaults.swift"
        }
      ],
      "info": {
        "path": "Widget/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Simastry",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "2",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
          }
        }
      },
      "entitlements": {
        "path": "Widget/SimastryWidgets.entitlements",
        "properties": {
          "com.apple.security.application-groups": [
            "group.com.simastry.shared"
          ]
        }
      },
      "settings": {
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "A6PP462J72",
        "MARKETING_VERSION": "1.0",
        "CURRENT_PROJECT_VERSION": "2",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.97a916bd-b131-48aa-a70e-082a3526b819.widgets",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1",
        "SKIP_INSTALL": "YES"
      }
    }
  }
}
